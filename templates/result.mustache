{{!
    @template search_typesense/result

    Renders a single search result with Moodle Design System link hygiene
    (no duplicate links to the same destination URL on a single result card).

    Context variables required for this template:
    * courseurl
    * coursefullname
    * title
    * docurl
    * contexturl

    Example context (json):
    {
        "courseurl": "https://example.com/course/view.php?id=2",
        "coursefullname": "Example course",
        "title": "Example title",
        "docurl": "https://example.com/mod/example/view.php?id=4",
        "content": "Example summary content",
        "contexturl": "https://example.com/mod/example/view.php?id=4",
        "areavisiblename": "Courses",
        "showcontextlink": false,
        "showcourselink": true
    }
}}
<div class="result search-typesense-result">
    <h4 class="result-title search-typesense-result__title">
        {{#iconname}}
            {{#pix}}{{iconname}}, {{iconcomponent}}{{/pix}}
        {{/iconname}}
        <a href="{{{docurl}}}">{{{title}}}</a>
        {{#areavisiblename}}
            <span class="badge badge-secondary bg-secondary text-white search-typesense-area-badge">{{areavisiblename}}</span>
        {{/areavisiblename}}
    </h4>
    {{#content}}
        <div class="result-content">{{{content}}}</div>
    {{/content}}
    {{#description1}}
        <div class="result-content">{{{description1}}}</div>
    {{/description1}}
    {{#description2}}
        <div class="result-content">{{{description2}}}</div>
    {{/description2}}
    {{#filename}}
        <div class="result-content-filename">
            {{#str}}matchingfile, search, {{{filename}}}{{/str}}
        </div>
    {{/filename}}
    {{#multiplefiles}}
        <div class="result-content-filenames">
            {{#str}}matchingfiles, search{{/str}}<br>
            <ul class="list">
            {{#filenames}}
                <li><span class="filename">{{.}}</span></li>
            {{/filenames}}
            </ul>
        </div>
    {{/multiplefiles}}
    <div class="result-context-info text-muted small">
        {{#showcontextlink}}
            <a href="{{{contexturl}}}">{{#str}}viewresultincontext, search{{/str}}</a>
            {{#showcourselink}} &middot; {{/showcourselink}}
        {{/showcontextlink}}
        {{#showcourselink}}
            <a href="{{{courseurl}}}">{{#str}}incourse, search, {{{coursefullname}}}{{/str}}</a>
        {{/showcourselink}}
        {{#userfullname}}
            {{#showcourselink}} &middot; {{/showcourselink}}<a href="{{{userurl}}}">{{#str}}byname, moodle, {{{userfullname}}}{{/str}}</a>
        {{/userfullname}}
    </div>
</div>
