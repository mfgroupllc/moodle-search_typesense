{{!
    @template search_typesense/shortcuts

    Site links that match the search, shown above the results.

    Context variables required for this template:
    * shortcuts - Links, each with label and clickurl.

    Example context (json):
    {
        "shortcuts": [
            {"label": "Student Portal", "clickurl": "https://example.com/search/engine/typesense/go.php?q=portal&link=ab12"},
            {"label": "Calendar", "clickurl": "https://example.com/search/engine/typesense/go.php?q=calendar&link=cd34"}
        ]
    }
}}
<nav class="search-typesense-shortcuts card mb-3" aria-labelledby="search-typesense-shortcuts-heading">
    <div class="card-body py-2">
        <h2 id="search-typesense-shortcuts-heading" class="h6 mb-2">{{#str}} shortcuts_heading, search_typesense {{/str}}</h2>
        <ul class="list-inline mb-0">
            {{#shortcuts}}
            <li class="list-inline-item mb-1">
                <a class="btn btn-outline-primary btn-sm" href="{{clickurl}}">{{label}}</a>
            </li>
            {{/shortcuts}}
        </ul>
    </div>
</nav>
